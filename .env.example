# Copy to .env and fill in.

# Transcription (audio -> text). https://console.groq.com/keys
# Claude has no audio input, so speech-to-text needs a dedicated provider.
GROQ_API_KEY=

# Summarization runs through the Claude Code CLI on your Max/Pro *subscription* —
# no Anthropic API key required. Just be logged in: run `claude` once and do /login.
# (Only set ANTHROPIC_API_KEY if you switch back to the API-based summarizer.)
# ANTHROPIC_API_KEY=

# Optional overrides
# RMP_OUTPUT_DIR=output
