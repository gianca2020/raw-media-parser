# Copy to .env and fill in. Both keys are required.

# Summarization (text -> markdown). https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Transcription (audio -> text). https://console.groq.com/keys
# This is the one unavoidable non-Claude dependency: Claude has no audio input.
GROQ_API_KEY=

# Optional overrides (defaults shown)
# RMP_MODEL=claude-opus-4-8
# RMP_EFFORT=medium
# RMP_OUTPUT_DIR=output
